# Copy to .env and fill in. Never commit .env.

# --- Database (docker-compose maps Postgres to host port 5433) ---
DATABASE_URL="postgresql://deal:deal@localhost:5433/deal_is_real"
# Separate DB used by integration tests (optional)
TEST_DATABASE_URL="postgresql://deal:deal@localhost:5433/deal_is_real_test"

# --- App ---
APP_URL="http://localhost:3000"
# User-Agent sent when fetching public product pages (Phase 3). Be honest about who you are.
FETCH_USER_AGENT="DealIsRealBot/0.1 (+https://github.com/kyang0617/deal-is-real)"

# --- Price providers (Phase 4). Leave blank to disable a provider. ---
PRICE_PROVIDERS="mock"            # comma-separated: mock,keepa,shopsavvy,bestbuy,amazon-creators
KEEPA_API_KEY=""
SHOPSAVVY_API_KEY=""
BESTBUY_API_KEY=""
AMAZON_CREATORS_CREDENTIAL_ID=""
AMAZON_CREATORS_CREDENTIAL_SECRET=""
AMAZON_CREATORS_PARTNER_TAG=""

# --- Email (Phase 5) ---
EMAIL_FROM="Deal Is Real <alerts@localhost>"
SMTP_URL="smtp://localhost:1025"  # Mailpit in docker-compose
RESEND_API_KEY=""                 # if set, Resend is used instead of SMTP
